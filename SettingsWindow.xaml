<Window x:Class="TeknoParrotBigBox.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="520"
        Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0A0A14"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#131120" />
        <SolidColorBrush x:Key="CardBg" Color="#1A1830" />
        <SolidColorBrush x:Key="ContentBg" Color="#0E0C1C" />
        <SolidColorBrush x:Key="BorderSubtle" Color="#22203A" />
        <SolidColorBrush x:Key="BorderMedium" Color="#302E48" />
        <SolidColorBrush x:Key="AccentCyan" Color="#00FFB3" />
        <SolidColorBrush x:Key="TextPrimary" Color="#DDDDEE" />
        <SolidColorBrush x:Key="TextSecondary" Color="#BBBBCC" />
        <SolidColorBrush x:Key="TextHint" Color="#9999AA" />

        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <!-- 青绿主按钮 -->
        <Style x:Key="GreenButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="#00B848"
                                BorderBrush="#00E676"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18,7"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#00FFB3" BlurRadius="12" ShadowDepth="0" Opacity="0.25" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#00D84E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#009E3A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#152E1A" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#1A3820" />
                                <Setter TargetName="bd" Property="Effect" Value="{x:Null}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 暗紫次按钮 -->
        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{StaticResource CardBg}"
                                BorderBrush="{StaticResource BorderMedium}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,7"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#262440" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#12102A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource ContentBg}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderMedium}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentCyan}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="DarkCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource ContentBg}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderMedium}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding WindowTitle}"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{StaticResource AccentCyan}">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#00FFB3" BlurRadius="8" ShadowDepth="0" Opacity="0.25" />
                </TextBlock.Effect>
            </TextBlock>
            <Border Height="1"
                    Margin="0,8,0,0"
                    Background="{StaticResource BorderSubtle}" />
        </StackPanel>

        <!-- 设置内容 -->
        <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.3" />
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,16,20,16">
                    <!-- 语言 -->
                    <TextBlock x:Name="LabelLanguage" Text="{Binding LanguageLabel}"
                               Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ComboBox x:Name="ComboLanguage"
                              Width="220"
                              Style="{StaticResource DarkComboBoxStyle}"
                              SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}" />

                    <!-- 分隔线 -->
                    <Border Height="1" Margin="0,16,0,16" Background="{StaticResource BorderSubtle}" />

                    <!-- Media 路径 -->
                    <TextBlock x:Name="LabelMediaPath" Text="{Binding MediaPathLabel}"
                               Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBox x:Name="TextBoxMediaPath"
                             Style="{StaticResource DarkTextBoxStyle}"
                             Text="{Binding MediaPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- 分隔线 -->
                    <Border Height="1" Margin="0,16,0,16" Background="{StaticResource BorderSubtle}" />

                    <!-- 调试选项 -->
                    <CheckBox x:Name="CheckBoxEnableDebugLog"
                              Content="{Binding EnableDebugLogLabel}"
                              Style="{StaticResource DarkCheckBoxStyle}"
                              IsChecked="{Binding EnableDebugLog, Mode=TwoWay}" Margin="0,0,0,8" />
                    <CheckBox x:Name="CheckBoxSkipVersionCheck"
                              Content="{Binding SkipVersionCheckLabel}"
                              Style="{StaticResource DarkCheckBoxStyle}"
                              IsChecked="{Binding SkipVersionCheck, Mode=TwoWay}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="ButtonOk" Content="{Binding ButtonOkText}"
                    Width="100" Height="34" Margin="0,0,8,0"
                    Click="ButtonOk_Click" IsDefault="True"
                    Style="{StaticResource GreenButtonStyle}" />
            <Button x:Name="ButtonCancel" Content="{Binding ButtonCancelText}"
                    Width="100" Height="34"
                    Click="ButtonCancel_Click" IsCancel="True"
                    Style="{StaticResource DarkButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
